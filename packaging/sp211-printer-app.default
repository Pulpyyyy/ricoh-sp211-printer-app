# Settings of the sp211-printer-app service, read when it starts:
#   sudo systemctl restart sp211-printer-app
#
# MQTT for Home Assistant: the printer appears by itself as a device of the
# MQTT integration (state, toner, counters, jobs, test pages, and a power
# switch that a plug can follow; see docs/MQTT.md). Off while MQTT_HOST is
# not set.
#
#MQTT_HOST=192.168.1.10
#MQTT_PORT=1883
#MQTT_USERNAME=sp211
#MQTT_PASSWORD=secret
#
# Rarely needed:
#MQTT_DISCOVERY_PREFIX=homeassistant
#MQTT_TOPIC=sp211-printer-app/sp211
#PRINTER_WEB_URL=http://192.168.1.14:631/
